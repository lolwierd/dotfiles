prefix_rule(pattern=["npm", "run", "build"], decision="allow")
prefix_rule(pattern=["swift", "test"], decision="allow")
prefix_rule(pattern=["swift", "-e", "import Foundation; let fm=FileManager.default; let p=\"/tmp\"; let x = try? fm.attributesOfItem(atPath: p)[.size] as? Int; print(type(of:x)); if let y=x { print(\"unwrapped type\", type(of:y), y as Any) } else { print(\"nil\") }"], decision="allow")
prefix_rule(pattern=["qmd", "collection", "add"], decision="allow")
prefix_rule(pattern=["pnpm", "test"], decision="allow")
