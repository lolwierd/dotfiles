{
    "settingssync.ignoredextensions": [],
    "chat.agent.maxRequests": 200,
    "chat.agent.thinkingStyle": "collapsedPreview",
    "chat.agent.todoList": {
        "position": "default"
    },
    "workbench.editor.enablePreview": false,
    "chat.checkpoints.showFileChanges": true,
    "chat.edits2.enabled": true,
    "chat.emptyState.history.enabled": true,
    "chat.instructionsFilesLocations": {
        "AGENTS.md": true
    },
    "inlineChat.enableV2": true,
    "workbench.startupEditor": "none",
    "workbench.colorTheme": "Dark 2026",
    "files.autoSave": "onFocusChange",
    "github.copilot.selectedCompletionModel": "",
    "github.copilot.chat.alternateGptPrompt.enabled": true,
    "github.copilot.chat.anthropic.thinking.enabled": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.editor.temporalContext.enabled": true,
    "github.copilot.chat.languageContext.typescript.enabled": true,
    "github.copilot.chat.newWorkspace.useContext7": true,
    "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
    "github.copilot.chat.notebook.followCellExecution.enabled": true,
    "github.copilot.chat.responsesApiReasoningEffort": "xhigh",
    "github.copilot.chat.scopeSelection": true,
    "githubPullRequests.pullRequestDescription": "Copilot",
    "redhat.telemetry.enabled": false,
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Dark 2026",
    "chat.tools.terminal.autoReplyToPrompts": true,
    "chat.renderRelatedFiles": true,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "chat.tools.terminal.autoApprove": {
        "git ls-files": true,
        "true": true,
        "rg": true,
        "/^npm run lint$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^npx tsc --noEmit$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "npm run type-check": true,
        "npm test": true,
        "npm run build": true,
        "npm install": true,
        "/^npm run -s type-check$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^npm run -s type-check:worker$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^pnpm --dir worker test$/": {
            "approve": true,
            "matchCommandLine": true
        }
    },
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "scm.repositories.selectionMode": "multiple",
    "makefile.configureOnOpen": false,
    "vim.useSystemClipboard": true,
    "search.globalFindClipboard": true,
    "editor.find.globalFindClipboard": true,
    "editor.wordWrap": "on",
    "editor.minimap.autohide": "mouseover",
    "diffEditor.ignoreTrimWhitespace": false,
    "explorer.confirmDragAndDrop": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.sharedViewState": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "chat.agentSessionsViewLocation": "view",
    "amp.url": "https://ampcode.com/",
    "editor.wordBasedSuggestions": "off",
    "amp.tab.enabled": false,
    "claudeCode.preferredLocation": "sidebar",
    "githubPullRequests.pullBranch": "never",
    "direnv.path.executable": "/opt/homebrew/bin/direnv",
    "amp.dangerouslyAllowAll": true,
    "markdown-preview-enhanced.codeBlockTheme": "vscode.css",
    "markdown-preview-enhanced.revealjsTheme": "night.css",
    "markdown-preview-enhanced.previewTheme": "vscode.css",
    "claudeCode.selectedModel": "opus",
    "diffEditor.maxComputationTime": 0,
    "git.openRepositoryInParentFolders": "always",
    "svelte.enable-ts-plugin": true,
    "workbench.editor.empty.hint": "hidden",
    // "workbench.editorAssociations": {
    //     "*.md": "vscode.markdown.preview.editor",
    //     "*.markdown": "vscode.markdown.preview.editor",
    //     "*.mdx": "vscode.markdown.preview.editor"
    // },
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "go.toolsManagement.autoUpdate": true,
    "workbench.preferredLightColorTheme": "Light Modern",
    "git.confirmSync": false,
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "chat.tools.global.autoApprove": true,
    "chat.mcp.gallery.enabled": true,
    "python.analysis.typeCheckingMode": "basic",
    "scm.diffDecorations": "none",
    "chat.viewSessions.orientation": "stacked",
    "chat.disableAIFeatures": true,
    "security.promptForLocalFileProtocolHandling": false,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ]
}