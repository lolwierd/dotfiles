# Jump to a project under ~/Projects (bound to ^f above).
cproj() {
  local selected

  if (( $# == 1 )); then
    selected=$1
  else
    selected=$(find "$HOME/Projects" -mindepth 1 -maxdepth 2 -type d | fzf) || return
  fi

  [[ -n $selected ]] || return

  cd -- "$selected" || return
  clear
}
