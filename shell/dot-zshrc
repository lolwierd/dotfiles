export NVM_DIR="$HOME/.nvm"
# Expose nvm global binaries (e.g. codex) without loading full nvm on startup.
if [[ -f "$NVM_DIR/alias/default" ]]; then
  _nvm_default_alias="$(<"$NVM_DIR/alias/default")"
  if [[ "$_nvm_default_alias" == v* && -d "$NVM_DIR/versions/node/$_nvm_default_alias/bin" ]]; then
    export PATH="$NVM_DIR/versions/node/$_nvm_default_alias/bin:$PATH"
  else
    typeset -a _nvm_bins
    _nvm_bins=("$NVM_DIR"/versions/node/v*/bin(Nn))
    (( ${#_nvm_bins} )) && export PATH="${_nvm_bins[-1]}:$PATH"
  fi
  unset _nvm_default_alias _nvm_bins
fi

# Lazy-load nvm/node toolchain on first use to avoid shell startup lag.
_lazy_load_nvm() {
  unset -f nvm node npm npx corepack pnpm yarn _lazy_load_nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm() { _lazy_load_nvm; nvm "$@"; }
node() { _lazy_load_nvm; node "$@"; }
npm() { _lazy_load_nvm; npm "$@"; }
npx() { _lazy_load_nvm; npx "$@"; }
corepack() { _lazy_load_nvm; corepack "$@"; }
pnpm() { _lazy_load_nvm; pnpm "$@"; }
yarn() { _lazy_load_nvm; yarn "$@"; }

