export NVM_DIR="$HOME/.nvm"
# nvm.sh lives beside $NVM_DIR for the install-script route, but inside the
# Cellar when nvm came from Homebrew. Resolve it once, here.
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  _nvm_sh="$NVM_DIR/nvm.sh"
  _nvm_completion="$NVM_DIR/bash_completion"
elif command -v brew >/dev/null 2>&1 && [[ -s "$(brew --prefix)/opt/nvm/nvm.sh" ]]; then
  _nvm_sh="$(brew --prefix)/opt/nvm/nvm.sh"
  _nvm_completion="$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm"
  [[ -d "$NVM_DIR" ]] || mkdir -p "$NVM_DIR"
fi

# Expose nvm global binaries (e.g. codex) without loading full nvm on startup.
if [[ -f "$NVM_DIR/alias/default" ]]; then
  _nvm_default_alias="$(<"$NVM_DIR/alias/default")"
  if [[ "$_nvm_default_alias" == v* && -d "$NVM_DIR/versions/node/$_nvm_default_alias/bin" ]]; then
    export PATH="$NVM_DIR/versions/node/$_nvm_default_alias/bin:$PATH"
  else
    typeset -a _nvm_bins
    _nvm_bins=("$NVM_DIR"/versions/node/v*/bin(Nn))
    (( ${#_nvm_bins} )) && export PATH="${_nvm_bins[-1]}:$PATH"
  fi
  unset _nvm_default_alias _nvm_bins
fi

# Lazy-load nvm/node toolchain on first use to avoid shell startup lag.
_nvm_lazy_wrapper() {
  unset -f nvm node npm npx corepack pnpm yarn
  [[ -n "$_nvm_sh" && -s "$_nvm_sh" ]] && \. "$_nvm_sh"
  [[ -n "$_nvm_completion" && -s "$_nvm_completion" ]] && \. "$_nvm_completion"
}
nvm()      { _nvm_lazy_wrapper; command nvm "$@"; }
node()     { _nvm_lazy_wrapper; command node "$@"; }
npm()      { _nvm_lazy_wrapper; command npm "$@"; }
npx()      { _nvm_lazy_wrapper; command npx "$@"; }
corepack() { _nvm_lazy_wrapper; command corepack "$@"; }
pnpm()     { _nvm_lazy_wrapper; command pnpm "$@"; }
yarn()     { _nvm_lazy_wrapper; command yarn "$@"; }

