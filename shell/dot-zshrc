# lg <pattern> -> ls -al | grep <pattern>
lg() {
  # Fuzzy-find a directory (filenames only) and cd into it.
  # Usage: lg [query] [depth]
  local query=""
  local depth="${LG_DEPTH:-4}"
  if [[ $# -ge 1 ]]; then
    query="$1"
  fi
  if [[ $# -ge 2 && "$2" == <-> ]]; then
    depth="$2"
  fi

  local dir=""
  if command -v fd >/dev/null 2>&1; then
    dir="$(fd --type d --hidden --follow --max-depth "$depth" . 2>/dev/null \
      | fzf --query "$query" --no-multi --prompt="dir> " --height=40% --reverse)"
  else
    dir="$(find . -maxdepth "$depth" -type d -not -path '*/.git/*' 2>/dev/null \
      | fzf --query "$query" --no-multi --prompt="dir> " --height=40% --reverse)"
  fi

  if [[ -n "$dir" ]]; then
    cd -- "$dir"
  fi
}

