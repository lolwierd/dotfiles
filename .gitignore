# macOS noise
.DS_Store

# local backups/temp
*.bak.*
*.backup*
*.tmp

# local pi runtime metadata (never commit from this repo)
.pi/

# local plugin checkouts
config/dot-config/tmux/plugins/

# local machine secrets
config/dot-config/zsh/keys.local.zsh

# secrets/auth (never commit)
**/auth.json
**/oauth_creds.json
**/google_accounts.json
**/token.json
**/rig.json
**/.env
**/.env.*
**/*.pem
**/*.p12
**/*.pfx
**/*credentials*.json

