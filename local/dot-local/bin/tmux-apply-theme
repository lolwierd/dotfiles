#!/usr/bin/env bash
# Picks a theme based on macOS appearance and sources it into the attached server.

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q "Dark"; then
  THEME="$HOME/.config/tmux/theme-dark.conf"
else
  THEME="$HOME/.config/tmux/theme-light.conf"
fi

# Only run if we're actually inside a tmux server
tmux run-shell "test -n \"\$TMUX\" || true" 2>/dev/null
tmux source-file "$THEME" 2>/dev/null || true
